<Window x:Class="AnalizaKoloruZdjęcia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnalizaKoloruZdjęcia"
        xmlns:vm="clr-namespace:AnalizaKoloruZdjęcia.ViewModels"
        xmlns:helpers="clr-namespace:AnalizaKoloruZdjęcia.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800"
        helpers:DragDropHelper.DropCommand="{Binding DropImageCommand}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Wybierz zdjęcie" Command="{Binding SelectImageCommand}" Margin="10"/>
            <DockPanel Margin="10,0,10,10">
                <TextBlock Text="Próg zgodności Hue (0-180): " DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HueThreshold, StringFormat={}{0:F0}}" DockPanel.Dock="Right" VerticalAlignment="Center" Width="30" TextAlignment="Right"/>
                <Slider Minimum="0" Maximum="180" Value="{Binding HueThreshold}" Margin="10,0" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            </DockPanel>
            <Image x:Name="SelectedImage" Source="{Binding SelectedImageSource}" Margin="10" Height="200"/>
            <Image x:Name="GeneratedImage" Source="{Binding GeneratedImageSource}" Margin="10" Height="200"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="ColorAnalysisResult" Text="{Binding ColorAnalysisResult}" Margin="10" FontSize="16" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
